# ═══════════════════════════════════════════════════════════════════════════════
# KhetiConnect - Full Stack Environment Variables Guide
# ═══════════════════════════════════════════════════════════════════════════════

# ─── BACKEND VARIABLES (server/.env) ──────────────────────────────────────────
# PORT=5000
# NODE_ENV=development
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kheticonnect?retryWrites=true&w=majority
# JWT_SECRET=your_jwt_secret_key_minimum_32_characters
# REFRESH_SECRET=your_refresh_secret_key_minimum_32_characters
# CLIENT_URL=http://localhost:3000,http://localhost:5173
# HUGGINGFACE_API_KEY=hf_your_huggingface_api_token
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_email_app_password
# IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
# IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ─── FRONTEND VARIABLES (client/.env) ─────────────────────────────────────────
# VITE_API_URL=http://localhost:5000
# VITE_ADMIN_PORTAL_URL=http://localhost:5001
# VITE_APP_NAME="KhetiConnect"
# VITE_APP_DESCRIPTION="Direct Farm-to-Buyer Marketplace & Agri-Ecosystem"
