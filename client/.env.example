# ─── KhetiConnect Frontend Environment Variables (Example Template) ──────────

# Backend API Base URL
# Leave empty to use relative paths with Vite proxy (/api -> http://localhost:5000)
# Or set explicitly for decoupled cross-origin production hosting (e.g. https://api.kheticonnect.com)
VITE_API_URL=

# Standalone Admin Portal URL
VITE_ADMIN_PORTAL_URL=http://localhost:5001

# Application Metadata
VITE_APP_NAME="KhetiConnect"
VITE_APP_DESCRIPTION="Direct Farm-to-Buyer Marketplace & Agri-Ecosystem"
