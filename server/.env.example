
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kheticonnect?retryWrites=true&w=majority

# Security & Authentication (Generate strong unique keys in production)
JWT_SECRET=your_jwt_secret_key_min_32_chars
REFRESH_SECRET=your_refresh_secret_key_min_32_chars

# CORS Allowed Client URLs (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Hugging Face AI Integration (KhetiBot Mulawwadawd_token
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Optional SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ImageKit Configuration (Crop Photo Uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

